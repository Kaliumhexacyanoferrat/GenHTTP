<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>

        <Description>Web server engine based on Microsoft Kestrel that can be used to develop applications using the GenHTTP development framework</Description>
        <PackageTags>GenHTTP HTTP Embedded Webserver Server Library C# Kestrel Engine</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>

    </PropertyGroup>

    <ItemGroup>

        <ProjectReference Include="..\..\API\GenHTTP.Api.csproj" />

        <ProjectReference Include="..\Shared\GenHTTP.Engine.Shared.csproj" />

        <!-- The IFeatureCollection<->IRequest/IResponse bridging lives in the adapter package,
             not here - Engine.Kestrel and Adapters.AspNetCore both need it, and an Engine must
             never reference a Module (the adapter itself does, for its Defaults() helper), so it
             can only live on the adapter side of this dependency, not the other way around. -->
        <ProjectReference Include="..\..\Adapters\AspNetCore\GenHTTP.Adapters.AspNetCore.csproj" />

        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="" />
    </ItemGroup>

</Project>
